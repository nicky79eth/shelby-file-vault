# "demo" stores the uploaded bytes in memory only long enough to return metadata.
# "shelby" uploads to Shelby Testnet with the server-side development account.
UPLOAD_PROVIDER=demo

# Required only when UPLOAD_PROVIDER=shelby
SHELBY_API_KEY=
APTOS_PRIVATE_KEY=

# Optional. Defaults to 30 days.
SHELBY_RETENTION_DAYS=30

# Maximum accepted upload size in MB. Vercel/server limits may be lower.
MAX_FILE_SIZE_MB=10
